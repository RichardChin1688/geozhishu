:root{
  --ink:#0d1117;
  --ink-2:#1c2128;
  --ink-3:#30363d;
  --paper:#ffffff;
  --paper-2:#f6f7f9;
  --paper-3:#eceff3;
  --line:#d8dde4;
  --line-2:#e8ebef;
  --accent:#0b5fff;
  --accent-2:#0842b8;
  --accent-soft:#eaf1ff;
  --amber:#b45309;
  --amber-soft:#fef3c7;
  --red:#b91c1c;
  --red-soft:#fef2f2;
  --green:#15803d;
  --green-soft:#f0fdf4;
  --muted:#5b6572;
  --muted-2:#8a94a1;
  --radius:6px;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei","Source Han Sans SC","Noto Sans CJK SC",sans-serif;
  --serif:"Songti SC","Source Han Serif SC","Noto Serif CJK SC",Georgia,"Times New Roman",serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:var(--sans);
  color:var(--ink);
  background:var(--paper);
  line-height:1.72;
  font-size:16px;
  -webkit-font-smoothing:antialiased;
}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
img{max-width:100%;display:block}
.wrap{max-width:1180px;margin:0 auto;padding:0 28px}
.narrow{max-width:820px;margin:0 auto;padding:0 28px}

/* ---------- header ---------- */
.site-head{
  border-bottom:1px solid var(--line);
  background:rgba(255,255,255,.94);
  backdrop-filter:saturate(180%) blur(12px);
  position:sticky;top:0;z-index:100;
}
.head-in{
  max-width:1180px;margin:0 auto;padding:0 28px;
  height:64px;display:flex;align-items:center;gap:36px;
}
.logo{display:flex;align-items:baseline;gap:9px;font-weight:700;letter-spacing:-.02em}
.logo .mark{
  font-family:var(--mono);font-size:17px;color:var(--paper);
  background:var(--ink);padding:3px 7px;border-radius:4px;letter-spacing:.02em;
}
.logo .nm{font-size:19px}
.logo .en{font-family:var(--mono);font-size:11px;color:var(--muted-2);letter-spacing:.08em;text-transform:uppercase}
.nav{display:flex;gap:26px;margin-left:auto;font-size:14.5px}
.nav a{color:var(--ink-2);font-weight:500}
.nav a:hover{color:var(--accent);text-decoration:none}
.nav a.on{color:var(--accent)}
.head-cta{
  font-size:13.5px;font-weight:600;color:var(--paper);background:var(--accent);
  padding:8px 16px;border-radius:var(--radius);
}
.head-cta:hover{background:var(--accent-2);text-decoration:none}

/* ---------- hero ---------- */
.hero{
  background:linear-gradient(180deg,#fbfcfe 0%,var(--paper) 100%);
  border-bottom:1px solid var(--line-2);
  padding:76px 0 64px;
}
.hero .kicker{
  font-family:var(--mono);font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--accent);font-weight:600;margin-bottom:20px;
}
.hero h1{
  font-family:var(--serif);font-size:52px;line-height:1.22;letter-spacing:-.02em;
  font-weight:700;max-width:900px;margin-bottom:22px;
}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero .lede{
  font-size:19px;color:var(--ink-2);max-width:720px;line-height:1.78;margin-bottom:36px;
}
.hero .lede strong{color:var(--ink);font-weight:600}

/* search box */
.search-box{
  background:var(--paper);border:1px solid var(--line);border-radius:10px;
  padding:20px;max-width:720px;
  box-shadow:0 1px 2px rgba(13,17,23,.04),0 8px 28px -12px rgba(13,17,23,.14);
}
.search-row{display:flex;gap:10px}
.search-row input{
  flex:1;font-family:var(--sans);font-size:16px;padding:13px 16px;
  border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-2);
  color:var(--ink);outline:none;
}
.search-row input:focus{border-color:var(--accent);background:var(--paper);box-shadow:0 0 0 3px var(--accent-soft)}
.search-row button{
  font-family:var(--sans);font-size:15px;font-weight:600;color:var(--paper);
  background:var(--accent);border:none;border-radius:var(--radius);
  padding:13px 26px;cursor:pointer;white-space:nowrap;
}
.search-row button:hover{background:var(--accent-2)}
.search-hint{font-size:12.5px;color:var(--muted-2);margin-top:12px;display:flex;flex-wrap:wrap;gap:14px}
.search-hint span{display:inline-flex;align-items:center;gap:5px}

/* ---------- stats strip ---------- */
.stats{border-bottom:1px solid var(--line-2);background:var(--paper-2)}
.stats-in{max-width:1180px;margin:0 auto;padding:0 28px;display:grid;grid-template-columns:repeat(4,1fr)}
.stat{padding:26px 0;border-right:1px solid var(--line)}
.stat:last-child{border-right:none}
.stat .num{font-family:var(--mono);font-size:27px;font-weight:600;letter-spacing:-.02em;color:var(--ink);line-height:1.2}
.stat .num small{font-size:14px;font-weight:500;color:var(--muted);margin-left:3px}
.stat .lb{font-size:12.5px;color:var(--muted);margin-top:4px}

/* ---------- section ---------- */
.sec{padding:72px 0;border-bottom:1px solid var(--line-2)}
.sec.alt{background:var(--paper-2)}
.sec-head{margin-bottom:44px}
.sec-head .tag{
  font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--accent);font-weight:600;margin-bottom:12px;
}
.sec-head h2{
  font-family:var(--serif);font-size:33px;line-height:1.3;letter-spacing:-.01em;font-weight:700;
  margin-bottom:12px;
}
.sec-head p{font-size:16.5px;color:var(--muted);max-width:680px}

/* ---------- 4 秤 cards ---------- */
.scales{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.scale{background:var(--paper);padding:28px 24px}
.scale .w{font-family:var(--mono);font-size:11.5px;color:var(--accent);font-weight:600;letter-spacing:.06em;margin-bottom:10px}
.scale h3{font-size:18px;font-weight:650;margin-bottom:3px;letter-spacing:-.01em}
.scale .code{font-family:var(--mono);font-size:11px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px}
.scale p{font-size:14.5px;color:var(--muted);line-height:1.7}
.scale .formula{
  font-family:var(--mono);font-size:11.5px;color:var(--ink-2);background:var(--paper-2);
  border-left:2px solid var(--accent);padding:9px 11px;margin-top:14px;border-radius:0 3px 3px 0;
  word-break:break-word;line-height:1.6;
}

/* ---------- tables ---------- */
.tbl-wrap{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--paper)}
.tbl-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--line);background:var(--paper-2);flex-wrap:wrap;gap:12px}
.tbl-head h3{font-size:16px;font-weight:650;letter-spacing:-.01em}
.tbl-head .meta{font-family:var(--mono);font-size:11.5px;color:var(--muted-2)}
table{width:100%;border-collapse:collapse;font-size:14.5px}
thead th{
  text-align:left;font-size:11.5px;font-weight:600;font-family:var(--mono);
  letter-spacing:.06em;text-transform:uppercase;color:var(--muted);
  padding:11px 16px;border-bottom:1px solid var(--line);background:var(--paper);
  white-space:nowrap;
}
tbody td{padding:13px 16px;border-bottom:1px solid var(--line-2);vertical-align:middle}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover{background:#fafbfc}
td.num{font-family:var(--mono);font-variant-numeric:tabular-nums;font-size:14px}
td.rank{font-family:var(--mono);font-weight:600;color:var(--muted-2);width:52px}
td.rank.top{color:var(--accent)}
.brand-cell{font-weight:600}
.brand-cell .sub{display:block;font-weight:400;font-size:12.5px;color:var(--muted-2);margin-top:1px}
.score{font-family:var(--mono);font-weight:600;font-size:15px}
.s-hi{color:var(--green)}
.s-mid{color:var(--amber)}
.s-lo{color:var(--red)}
.bar{width:88px;height:5px;background:#dfe4ea;border-radius:3px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent);border-radius:3px}
.bar.lo i{background:var(--red)}
.bar.mid i{background:var(--amber)}
.bar.hi i{background:var(--green)}
.pill{
  display:inline-block;font-family:var(--mono);font-size:10.5px;font-weight:600;
  letter-spacing:.05em;text-transform:uppercase;padding:2px 7px;border-radius:3px;
}
.pill.l1{background:#eef6ff;color:#0369a1}
.pill.l2{background:var(--green-soft);color:var(--green)}
.pill.l3{background:var(--amber-soft);color:var(--amber)}
.pill.l6{background:var(--red-soft);color:var(--red)}
.pill.rel{background:#f3e8ff;color:#7e22ce}

/* ---------- warn cards ---------- */
.warn-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.warn{
  border:1px solid var(--line);border-left:3px solid var(--red);border-radius:var(--radius);
  background:var(--paper);padding:22px 24px;
}
.warn .hd{display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap}
.warn h3{font-size:16px;font-weight:650;letter-spacing:-.01em}
.warn .src{font-family:var(--mono);font-size:11px;color:var(--muted-2)}
.warn p{font-size:14.5px;color:var(--muted);line-height:1.72}
.warn .chain{
  font-family:var(--mono);font-size:11.5px;color:var(--ink-2);background:var(--red-soft);
  padding:10px 12px;border-radius:3px;margin-top:14px;line-height:1.7;
}

/* ---------- process / steps ---------- */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.step{background:var(--paper);padding:26px 24px}
.step .n{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--accent);letter-spacing:.08em;margin-bottom:12px}
.step h3{font-size:16.5px;font-weight:650;margin-bottom:8px}
.step p{font-size:14.5px;color:var(--muted);line-height:1.7}

/* ---------- principle list ---------- */
.plist{display:grid;gap:0;border-top:1px solid var(--line)}
.pitem{display:grid;grid-template-columns:56px 1fr;gap:20px;padding:22px 0;border-bottom:1px solid var(--line-2);align-items:start}
.pitem .ic{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--paper);background:var(--ink);width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:5px}
.pitem h3{font-size:16.5px;font-weight:650;margin-bottom:5px;letter-spacing:-.01em}
.pitem p{font-size:14.5px;color:var(--muted);line-height:1.72}

/* ---------- footer ---------- */
.site-foot{background:var(--ink);color:#98a2b3;padding:56px 0 32px;font-size:14px}
.foot-in{max-width:1180px;margin:0 auto;padding:0 28px;display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:44px}
.site-foot .logo .mark{background:#fff;color:var(--ink)}
.site-foot .logo .nm{color:#fff}
.site-foot .logo .en{color:#64748b}
.site-foot .desc{margin-top:16px;line-height:1.75;font-size:13.5px;color:#8a94a1;max-width:320px}
.site-foot h4{color:#fff;font-size:13px;font-weight:600;margin-bottom:14px;letter-spacing:.02em}
.site-foot ul{list-style:none;display:grid;gap:9px}
.site-foot a{color:#98a2b3;font-size:13.5px}
.site-foot a:hover{color:#fff;text-decoration:none}
.foot-bar{
  max-width:1180px;margin:40px auto 0;padding:24px 28px 0;border-top:1px solid #262d36;
  font-size:12.5px;color:#64748b;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;
}
.foot-bar a{color:#64748b;font-size:12.5px}

/* ---------- misc ---------- */
.note{
  background:var(--accent-soft);border:1px solid #cfe0ff;border-radius:var(--radius);
  padding:16px 20px;font-size:14.5px;color:#1e3a8a;margin:24px 0;
}
.note.amber{background:var(--amber-soft);border-color:#fde68a;color:#78350f}
.note.red{background:var(--red-soft);border-color:#fecaca;color:#7f1d1d}
.note strong{font-weight:650}
.page-head{padding:52px 0 40px;border-bottom:1px solid var(--line-2);background:linear-gradient(180deg,#fbfcfe,var(--paper))}
.page-head .crumb{font-family:var(--mono);font-size:11.5px;color:var(--muted-2);letter-spacing:.08em;margin-bottom:14px;text-transform:uppercase}
.page-head h1{font-family:var(--serif);font-size:38px;line-height:1.28;letter-spacing:-.02em;font-weight:700;margin-bottom:14px}
.page-head p{font-size:16.5px;color:var(--muted);max-width:700px}
.btn{display:inline-block;font-size:14.5px;font-weight:600;padding:11px 22px;border-radius:var(--radius);background:var(--accent);color:#fff}
.btn:hover{background:var(--accent-2);text-decoration:none}
.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--line)}
.btn.ghost:hover{background:var(--accent-soft);text-decoration:none}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:36px}
.dl{display:grid;gap:2px;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.dl-row{display:grid;grid-template-columns:190px 1fr;gap:16px;padding:14px 20px;background:var(--paper);font-size:14.5px;border-bottom:1px solid var(--line-2)}
.dl-row:last-child{border-bottom:none}
.dl-row dt{color:var(--muted);font-size:13.5px}
.dl-row dd{font-weight:500}

@media(max-width:900px){
  .hero h1{font-size:36px}
  .stats-in{grid-template-columns:repeat(2,1fr)}
  .stat:nth-child(2){border-right:none}
  .scales,.steps{grid-template-columns:1fr 1fr}
  .warn-grid,.two-col{grid-template-columns:1fr}
  .foot-in{grid-template-columns:1fr 1fr}
  .nav{display:none}
}
@media(max-width:600px){
  .wrap,.narrow,.head-in,.stats-in,.foot-in,.foot-bar{padding-left:18px;padding-right:18px}
  .hero{padding:48px 0 40px}
  .hero h1{font-size:28px}
  .hero .lede{font-size:16.5px}
  .sec{padding:48px 0}
  .scales,.steps{grid-template-columns:1fr}
  .search-row{flex-direction:column}
  .search-row button{width:100%}
  .tbl-wrap{overflow-x:auto}
  table{min-width:640px}
  .sec-head h2{font-size:25px}
  .page-head h1{font-size:27px}
  .dl-row{grid-template-columns:1fr;gap:2px}
}
